# Environment configuration conventions
# --------------------------------------
# Development: copy this file to `.env` (same directory) and adjust values.
#   `.env` is git-ignored and never committed.
# Staging / Production: these variables are injected by the hosting
#   platform's own environment configuration, not read from a committed
#   file. No cloud provider is fixed by this project (see SPECS.md 34);
#   whatever platform is chosen must set these same variable names.
#
# This root file only configures the local docker-compose PostgreSQL
# service. Each app (apps/api, apps/web) has its own .env.example for the
# variables it reads at runtime.

POSTGRES_USER=bmp
POSTGRES_PASSWORD=bmp_dev_password
POSTGRES_DB=bmp_dev
POSTGRES_PORT=5432
