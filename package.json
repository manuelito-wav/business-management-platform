{
  "name": "business-management-platform",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
