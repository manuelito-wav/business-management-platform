# Dependencies
node_modules/

# Build output
dist/
.next/
build/

# Turborepo
.turbo/

# TypeScript incremental build cache
*.tsbuildinfo

# Prisma generated client (regenerated via `prisma generate`)
**/generated/prisma/

# Environment files (never commit real secrets)
.env
.env.local
.env.*.local

# Test / coverage
coverage/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# Claude Code local worktrees for background/spawned sessions (already
# excluded locally via .git/info/exclude, which is machine-local and not
# shared -- listed here too so shared tooling like `prettier --check .`
# skips them on every machine/CI, not just this one).
.claude/worktrees/
