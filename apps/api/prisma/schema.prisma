// Phase 1 -- "add password authentication and sessions". These models are
// deliberately NOT tenant-owned (no business_id): a User is a global
// identity that can join multiple businesses via Membership, introduced in
// the next checkpoint (see SPECS.md 4.2, ARCHITECTURE.md "Tenancy").

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum UserStatus {
  active
  inactive
}

model User {
  id           String     @id
  email        String     @unique
  username     String?    @unique
  passwordHash String     @map("password_hash")
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  sessions            UserSession[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

// One row per login. Both the access and refresh credential live on the
// same session so "list my devices" / "revoke this device" (a later Phase 1
// checkpoint) has one row per device to show and terminate. Only hashes are
// stored -- the raw tokens are returned to the client once and never
// persisted (see D-040-adjacent security notes in ARCHITECTURE.md Tenancy).
model UserSession {
  id     String @id
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessTokenHash       String    @unique @map("access_token_hash")
  accessTokenExpiresAt  DateTime  @map("access_token_expires_at")
  refreshTokenHash      String    @unique @map("refresh_token_hash")
  refreshTokenExpiresAt DateTime  @map("refresh_token_expires_at")

  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  @@index([userId])
  @@map("user_sessions")
}

model PasswordResetToken {
  id     String @id
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}
