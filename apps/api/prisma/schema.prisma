// Phase 1. User/UserSession/PasswordResetToken (below) are deliberately NOT
// tenant-owned (no business_id): a User is a global identity that joins
// multiple businesses via Membership (see SPECS.md 4.2, ARCHITECTURE.md
// "Tenancy"). Business, Membership, and Role ARE tenant-owned per D-043.
// Permission is a global, non-tenant-owned catalog (D-038): the identifier
// scheme is shared across every business, not per-business data.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum UserStatus {
  active
  inactive
}

model User {
  id           String     @id
  email        String     @unique
  username     String?    @unique
  passwordHash String     @map("password_hash")
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  sessions            UserSession[]
  passwordResetTokens PasswordResetToken[]
  memberships         Membership[]

  @@map("users")
}

// One row per login. Both the access and refresh credential live on the
// same session so "list my devices" / "revoke this device" (a later Phase 1
// checkpoint) has one row per device to show and terminate. Only hashes are
// stored -- the raw tokens are returned to the client once and never
// persisted (see D-040-adjacent security notes in ARCHITECTURE.md Tenancy).
model UserSession {
  id     String @id
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessTokenHash       String   @unique @map("access_token_hash")
  accessTokenExpiresAt  DateTime @map("access_token_expires_at")
  refreshTokenHash      String   @unique @map("refresh_token_hash")
  refreshTokenExpiresAt DateTime @map("refresh_token_expires_at")

  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  // The business currently selected as "active" for this session (SPECS.md
  // 4.2: "the active business must be explicit in application context").
  // This is only a pointer, not a cached permission claim -- every
  // protected operation still re-evaluates membership/permission against
  // current database state (ARCHITECTURE.md Tenancy), it is never trusted
  // by itself.
  activeBusinessId String?   @map("active_business_id")
  activeBusiness   Business? @relation(fields: [activeBusinessId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("user_sessions")
}

model PasswordResetToken {
  id     String @id
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

enum BusinessStatus {
  active
  inactive
}

model Business {
  id               String         @id
  name             String
  businessTimezone String         @default("America/Argentina/Buenos_Aires") @map("business_timezone")
  status           BusinessStatus @default(active)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  memberships        Membership[]
  roles              Role[]
  activeSessions     UserSession[]
  configurations     BusinessConfiguration[]
  auditEvents        AuditEvent[]
  categories         Category[]
  products           Product[]
  productIdentifiers ProductIdentifier[]
  productPricings    ProductPricing[]
  priceLists         PriceList[]
  priceListEntries   PriceListEntry[]
  registers          Register[]
  registerSessions   RegisterSession[]
  inventoryMovements InventoryMovement[]
  productStocks      ProductStock[]
  expirationBatches  ProductExpirationBatch[]

  @@map("businesses")
}

// One row per configuration section (D-035-adjacent business config: payment
// methods, feature flags, policies, and later module settings). Keyed by an
// application-level `key` rather than a fixed column per section, so a new
// module can register its own section later without a schema migration --
// see apps/api/src/configuration/configuration-registry.ts, the typed
// registry that owns each section's shape and safe default. Data, not code:
// values are plain JSON, validated against the registry on write and
// re-validated (falling back to the safe default) on read.
model BusinessConfiguration {
  id         String   @id
  businessId String   @map("business_id")
  key        String
  value      Json
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, key])
  @@index([businessId])
  @@map("business_configurations")
}

enum MembershipStatus {
  active
  inactive
}

// A user's link to one business, and the single role that link carries
// (SPECS.md 4.2: "Business A: Administrator. Business B: Employee.").
// Revoking access sets status to inactive rather than deleting the row,
// per D-037 -- the historical assignment is kept.
model Membership {
  id         String @id
  userId     String @map("user_id")
  businessId String @map("business_id")
  roleId     String @map("role_id")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Composite FK against Role's (id, businessId), not just roleId, so the
  // database itself rejects assigning a role from a different business --
  // defense in depth alongside the application-level check in
  // MembershipsService.requireRoleInBusiness (tenant isolation is priority
  // #1 per AGENT.md).
  role     Role     @relation(fields: [roleId, businessId], references: [id, businessId])

  status    MembershipStatus @default(active)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@unique([userId, businessId])
  @@index([businessId])
  @@index([userId])
  @@map("memberships")
}

// Roles are business-owned (D-043: every tenant-owned table carries
// business_id), even the four predefined ones -- each business gets its
// own copies at creation (isSystem = true), so one business editing its
// "Manager" role's permissions never affects another business's. Roles
// are collections of permissions; a role's name grants nothing by itself
// (D-038) -- authorization always evaluates RolePermission, never the name.
model Role {
  id         String  @id
  businessId String  @map("business_id")
  name       String
  isSystem   Boolean @default(false) @map("is_system")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  memberships     Membership[]
  rolePermissions RolePermission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([businessId, name])
  @@unique([id, businessId])
  @@index([businessId])
  @@map("roles")
}

// Global permission catalog (D-038): `<module>.<action>` identifiers are
// shared across every business, so this table is NOT tenant-owned -- it
// has no business_id. This is the seed set of examples from D-038, not
// the final exhaustive catalog (see DECISIONS.md "Pending decisions").
model Permission {
  code        String @id
  module      String
  action      String
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId         String @map("role_id")
  permissionCode String @map("permission_code")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@id([roleId, permissionCode])
  @@map("role_permissions")
}

// Immutable operational-fact table (D-043): append-only, physically separate
// from operational tables, indexed business + entity(target type) + date per
// D-043's own stated pattern. Deliberately no onDelete: Cascade from
// Business -- an audit trail must outlive the row it describes changes to
// (D-017/D-037: historical facts are never deleted or destructively
// modified). actorUserId is a plain reference, not a foreign key, for the
// same reason on the User side. "Minimal" before/after data only (SPECS.md
// 23.2: "Avoid storing unnecessarily large object copies") -- the changed
// fields, never a full row snapshot.
model AuditEvent {
  id            String @id
  businessId    String @map("business_id")
  actorUserId   String @map("actor_user_id")
  action        String
  targetType    String @map("target_type")
  targetId      String @map("target_id")
  beforeData    Json?  @map("before_data")
  afterData     Json?  @map("after_data")
  correlationId String @map("correlation_id")

  createdAt DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId, targetType, createdAt])
  @@map("audit_events")
}

enum CategoryStatus {
  active
  inactive
}

// Flat, not hierarchical: SPECS.md only describes categories as POS
// "quick-access" visual groups (6.2), never a category tree. A nested
// structure would be speculative until a real need for it appears.
model Category {
  id         String         @id
  businessId String         @map("business_id")
  name       String
  status     CategoryStatus @default(active)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([businessId, name])
  // Lets Product's category relation be a composite FK against (id,
  // businessId), the same cross-tenant defense used for Membership/Role.
  @@unique([id, businessId])
  @@index([businessId])
  @@map("categories")
}

enum ProductSaleMode {
  unit
  weighted
}

enum ProductStatus {
  active
  inactive
}

enum ProductWeightUnit {
  g
  kg
}

// Pricing (cost/salePrice/profit/marginPercent) lives in its own
// ProductPricing record (below), not on this table -- ARCHITECTURE.md
// lists `pricing` as its own module, separate from `catalog`, and a
// product may exist in the catalog before its pricing is configured.
// `imageUrl` is a plain optional URL column: no object-storage SDK is
// wired up yet (D-020: images are optional shortcuts, the catalog stays
// fully searchable without them; the infra doc's own sequencing
// introduces S3-compatible storage "when images... are enabled", i.e.
// with a real upload flow, not preemptively here).
// `weightUnit` is display/input preference only (D-008): the authoritative
// internal unit for any weighted quantity is always the integer gram (see
// @bmp/domain's weight.ts) -- this column never stores a quantity itself.
// Required exactly when saleMode is weighted, enforced in
// ProductsService, not at the schema level (Postgres CHECK constraints
// spanning two columns are avoidable complexity Prisma does not model
// natively; this project prefers explicit service-level validation).
model Product {
  id                        String             @id
  businessId                String             @map("business_id")
  categoryId                String             @map("category_id")
  name                      String
  description               String?
  saleMode                  ProductSaleMode    @default(unit) @map("sale_mode")
  weightUnit                ProductWeightUnit? @map("weight_unit")
  imageUrl                  String?            @map("image_url")
  // Optional per product (SPECS.md 7.3 "Minimum stock" -- listed beside
  // barcode/SKU/image as an optional field a given product may or may not
  // have set, not a business-wide feature flag). Same native inventory
  // unit as ProductStock.quantityOnHand/InventoryMovement.quantity: whole
  // units for saleMode "unit", integer grams for "weighted" (D-008).
  // Null means this product has no configured threshold and never
  // appears in the low-stock alert list (ROADMAP.md "add low-stock/
  // minimum-stock projections").
  minimumStock              Int?               @map("minimum_stock")
  // Per-product opt-in (SPECS.md 8.4 "Not every product requires
  // expiration tracking"), meaningful only once the business itself has
  // also enabled featureFlags.expirationTracking (already seeded,
  // default false, in configuration/sections/feature-flags.config.ts) --
  // both gates are checked where it actually matters, at
  // ExpirationBatchesService.createBatch, not here. Settable anytime,
  // the same unconditional-field pattern as minimumStock.
  expirationTrackingEnabled Boolean            @default(false) @map("expiration_tracking_enabled")
  status                    ProductStatus      @default(active)
  createdAt                 DateTime           @default(now()) @map("created_at")
  updatedAt                 DateTime           @updatedAt @map("updated_at")

  business           Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Composite FK: prevents assigning a category that belongs to a
  // different business (cross-tenant leakage), same pattern as
  // Membership.role.
  category           Category                 @relation(fields: [categoryId, businessId], references: [id, businessId])
  identifiers        ProductIdentifier[]
  pricing            ProductPricing?
  priceListEntries   PriceListEntry[]
  inventoryMovements InventoryMovement[]
  stock              ProductStock?
  expirationBatches  ProductExpirationBatch[]

  @@unique([id, businessId])
  @@index([businessId, name])
  @@map("products")
}

enum ProductIdentifierType {
  barcode
  sku
  external
}

// One product may carry several identifiers (SPECS.md 6.2: "Barcode. SKU.
// Other configured identifiers.") -- multiple barcodes (case vs. unit,
// supplier-specific) are common in real retail catalogs. `normalizedValue`
// (trimmed + uppercased, see product-identifier-normalization.ts) is what
// uniqueness and search actually index against, per business and type --
// ROADMAP.md "per-business uniqueness rules" / "index normalised
// barcode/SKU/external identifiers".
model ProductIdentifier {
  id              String                @id
  businessId      String                @map("business_id")
  productId       String                @map("product_id")
  type            ProductIdentifierType
  value           String
  normalizedValue String                @map("normalized_value")
  createdAt       DateTime              @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([businessId, type, normalizedValue])
  @@index([businessId, normalizedValue])
  @@index([productId])
  @@map("product_identifiers")
}

enum PricingInputMode {
  sale_price
  profit
  margin_percent
}

// At most one pricing record per product (D-006/D-007). Money fields
// (costPrice, salePrice, profit) are integers in ARS minor units (cents)
// per D-005 -- never floats, never an unscaled decimal.
// marginPercentBasisPoints is the D-006 formula's result stored as an
// integer scaled by 100 (1% = 100 basis points), for the same float-free,
// deterministic-rounding reason applied to a derived percentage rather
// than raw currency; @bmp/domain's pricing.ts owns the calculation and
// rounding. It is null exactly when costPrice is 0 -- the formula is
// mathematically undefined there (D-032), never coerced to zero.
// inputMode records which of the three synchronized fields (D-007:
// salePrice, profit, or margin%) last drove a recalculation; a cost-only
// update (D-007's fourth, unconditional case -- cost changes always
// preserve salePrice) leaves it unchanged.
model ProductPricing {
  id         String @id
  businessId String @map("business_id")
  productId  String @map("product_id")

  costPrice                Int              @map("cost_price")
  salePrice                Int              @map("sale_price")
  profit                   Int
  marginPercentBasisPoints Int?             @map("margin_percent_basis_points")
  inputMode                PricingInputMode @map("input_mode")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Composite FK: prevents pricing from pointing at a product belonging
  // to a different business, same pattern as Category/ProductIdentifier.
  // The compound unique below (rather than a plain @unique on productId)
  // is what Prisma requires to treat Product.pricing as one-to-one while
  // the FK itself stays composite -- it still enforces "at most one
  // pricing record per product", since businessId is functionally
  // dependent on productId (a product belongs to exactly one business).
  product  Product  @relation(fields: [productId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([productId, businessId])
  @@index([businessId])
  @@map("product_pricing")
}

enum PriceListStatus {
  active
  inactive
}

// Optional, disabled-by-default feature (SPECS.md 7.5/19.1), gated by
// BusinessConfiguration's featureFlags.priceLists (see
// configuration/sections/feature-flags.config.ts) -- ROADMAP.md "keep
// the feature disabled ... until enabled per business". A named
// alternate price list (SPECS.md 7.5 examples: Employee, Retail,
// Wholesale). This checkpoint ships only the data model and a read-only
// selection boundary (PriceListsService.resolveEffectivePrice) -- no
// live sale flow consumes it yet; ROADMAP.md's later Phase 8 checkpoint
// ("enable configurable price lists") is what wires selection into a
// sale and snapshots the result onto a sale line.
model PriceList {
  id         String          @id
  businessId String          @map("business_id")
  name       String
  status     PriceListStatus @default(active)
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  business Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entries  PriceListEntry[]

  @@unique([businessId, name])
  // Lets PriceListEntry's priceList relation be a composite FK against
  // (id, businessId), the same cross-tenant defense used throughout
  // catalog/pricing.
  @@unique([id, businessId])
  @@index([businessId])
  @@map("price_lists")
}

// One override sale price per (price list, product) pair. Deliberately
// no cost/profit/Margin % here: those stay single, business-wide facts
// owned by ProductPricing, never duplicated per list -- a price list
// only ever overrides what the customer pays, resolved against the same
// product cost via @bmp/domain's resolvePricing (D-006) if a margin
// figure is ever needed for one.
model PriceListEntry {
  id          String   @id
  businessId  String   @map("business_id")
  priceListId String   @map("price_list_id")
  productId   String   @map("product_id")
  salePrice   Int      @map("sale_price")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business  Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Composite FKs: prevent an entry from pointing at a price list or
  // product belonging to a different business.
  priceList PriceList @relation(fields: [priceListId, businessId], references: [id, businessId], onDelete: Cascade)
  product   Product   @relation(fields: [productId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([priceListId, productId])
  @@index([businessId])
  @@index([productId])
  @@map("price_list_entries")
}

enum RegisterStatus {
  active
  inactive
}

// Registers belong to the business, never permanently to a user
// (SPECS.md 11.1, D-009) -- a user only "operates" one via a
// RegisterSession (below), for the duration of that session.
model Register {
  id         String         @id
  businessId String         @map("business_id")
  name       String
  status     RegisterStatus @default(active)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sessions RegisterSession[]

  @@unique([businessId, name])
  // Lets RegisterSession's register relation be a composite FK against
  // (id, businessId), the same cross-tenant defense used throughout.
  @@unique([id, businessId])
  @@index([businessId])
  @@map("registers")
}

enum RegisterSessionStatus {
  open
  closed
}

// One operational session per register-use (SPECS.md 11.1/11.2, D-009):
// a user manually selects an authorized register and opens a session to
// operate it, closing it when done. `userId` is a plain reference, not a
// foreign key, for the same reason as AuditEvent.actorUserId -- D-043
// lists "register closes" among the immutable operational-fact tables,
// and a closed session is exactly that kind of historical fact; it must
// outlive the user it describes even after a later checkpoint adds
// close-time expected/counted/discrepancy fields on top of this same
// table. `openingAmount` is the optional starting cash/change fund
// (SPECS.md 11.6), required or not per the business's own
// registerPolicy configuration (registerPolicy.requireOpeningAmount) --
// enforced in RegisterSessionsService, not the schema. Only the session's
// own user may close it in this checkpoint; the multi-user conflict/
// override policy for closing someone else's active session
// (SPECS.md 11.3) is intentionally not implemented here -- see
// DECISIONS.md "Pending decisions" and ROADMAP.md's later "register
// closing and discrepancy handling" checkpoint, which is what the
// already-seeded register.close/register.override_close_conflict
// permissions are for.
model RegisterSession {
  id         String                @id
  businessId String                @map("business_id")
  registerId String                @map("register_id")
  userId     String                @map("user_id")
  status     RegisterSessionStatus @default(open)

  // Mirrors `registerId` while status is "open"; set to null the moment
  // the session closes. The unique constraint below then turns "at most
  // one open session per register" into a real database guarantee
  // (Postgres does not treat NULLs as equal for uniqueness) rather than
  // an optimistic find-then-create check -- closes the race where two
  // concurrent opens for the same register could otherwise both pass.
  activeRegisterId String? @unique @map("active_register_id")

  openingAmount Int? @map("opening_amount")

  openedAt DateTime  @default(now()) @map("opened_at")
  closedAt DateTime? @map("closed_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Composite FK: prevents a session from pointing at a register
  // belonging to a different business, same pattern as Category/Product.
  register Register @relation(fields: [registerId, businessId], references: [id, businessId], onDelete: Cascade)

  @@index([businessId])
  @@index([registerId])
  @@index([userId])
  @@map("register_sessions")
}

enum InventoryMovementReason {
  sale
  receiving
  manual_adjustment
  loss
  return
}

// SPECS.md 8.3's configurable loss sub-reasons. A fixed enum, not a
// per-business configurable list (BusinessConfiguration's registry
// pattern): SPECS.md's own list ("configurable options such as...") reads
// as this exact set being the intended options, not an invitation for
// each business to define its own taxonomy, and nothing in DECISIONS.md
// asks for per-business customization here.
enum InventoryLossReason {
  theft
  damage
  expiration
  other
}

// Append-only source of truth for stock changes (D-015; ARCHITECTURE.md
// "Inventory": "immutable movement ledger plus current-stock projection").
// Movements are never updated or deleted -- a correction is a new,
// opposite-signed movement, the same append-only discipline as
// AuditEvent. `quantity` is a signed delta in the product's own
// inventory unit: whole units for saleMode "unit", integer grams for
// saleMode "weighted" (D-008 -- grams are the one authoritative
// weighted-quantity precision throughout the system, not just at sale
// time). Positive increases stock (e.g. receiving), negative decreases
// it (e.g. sale, loss). `reason` covers SPECS.md 8.1's movement types;
// `lossReason` (SPECS.md 8.3) is required exactly when `reason` is
// "loss" and forbidden otherwise -- enforced in InventoryService, the
// same pattern as Product.weightUnit's saleMode-conditional requirement.
// `sourceOperationId` is a plain, opaque reference to whatever operation
// produced the movement (a future sale/receiving/adjustment id) -- never
// a foreign key, since inventory does not read another module's tables
// (ARCHITECTURE.md "Modules"). `actorUserId`/`correlationId` are
// likewise plain references, matching AuditEvent's established pattern
// (D-043: immutable operational-fact tables carry an actor reference and
// correlation/operation IDs) -- a movement must outlive the user who
// caused it. No register/session reference is added yet: none of this
// phase's movements (this ledger foundation; receiving/adjustment/loss
// next) are register-scoped -- D-043's "where the fact is register-
// scoped" carve-out. That field is deferred to Phase 4's sale-settlement
// checkpoint, the first one that actually needs it.
model InventoryMovement {
  id                String                  @id
  businessId        String                  @map("business_id")
  productId         String                  @map("product_id")
  reason            InventoryMovementReason
  quantity          Int
  lossReason        InventoryLossReason?    @map("loss_reason")
  sourceOperationId String?                 @map("source_operation_id")
  actorUserId       String                  @map("actor_user_id")
  correlationId     String                  @map("correlation_id")
  occurredAt        DateTime                @default(now()) @map("occurred_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Composite FK: prevents a movement from pointing at a product
  // belonging to a different business, same pattern as ProductPricing.
  product  Product  @relation(fields: [productId, businessId], references: [id, businessId], onDelete: Cascade)

  @@index([businessId])
  @@index([productId])
  @@map("inventory_movements")
}

// The "current-stock projection" ROADMAP.md asks for: a fast, repairable
// read model kept in sync with InventoryMovement inside the very same
// transaction as every write (InventoryService.recordMovement), never
// written independently of it. `quantityOnHand` can always be recomputed
// exactly by summing InventoryMovement.quantity for the product
// (InventoryService.reconcileStock) -- the ledger, not this table, is
// the source of truth; this table only exists so a read does not have to
// aggregate the whole ledger every time (ROADMAP.md "for fast reads").
model ProductStock {
  id             String   @id
  businessId     String   @map("business_id")
  productId      String   @map("product_id")
  quantityOnHand Int      @default(0) @map("quantity_on_hand")
  updatedAt      DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Composite FK, same pattern as ProductPricing: at most one stock row
  // per product, and it cannot point at a product in a different business.
  product  Product  @relation(fields: [productId, businessId], references: [id, businessId], onDelete: Cascade)

  @@unique([productId, businessId])
  @@index([businessId])
  @@map("product_stock")
}

// Product/batch expiration data (ROADMAP.md "add optional expiration
// tracking"; SPECS.md 8.4). Deliberately NOT linked to InventoryMovement
// or ProductStock -- ROADMAP.md "Keep this isolated from the non-
// expiration inventory path": a batch is metadata about a known
// perishable delivery for alerting purposes only, never itself an
// inventory fact. `quantity` is informational (how many units/grams --
// D-008 -- were logged in this batch at creation time); it is never
// decremented as the product sells and is not reconciled against
// ProductStock.quantityOnHand -- true per-batch/FEFO stock tracking is
// out of scope here, matching ROADMAP's "informational-only" framing.
// `expiresAt` is a UTC instant (D-036) representing a calendar date;
// display converts to the business's own timezone.
// `resolvedAt` records that an authorized user completed the "alert ->
// physical verification -> decision" workflow SPECS.md 8.4 describes --
// set only by ExpirationBatchesService.resolveBatch, never automatically;
// a resolved batch stops appearing in the alert list regardless of its
// actual expiresAt. The decision itself (leave stock available, record a
// loss via the existing recordLoss command with lossReason "expiration",
// or any other configured action) happens through its own existing
// command and is not tracked on this row -- only that a human handled it.
model ProductExpirationBatch {
  id            String    @id
  businessId    String    @map("business_id")
  productId     String    @map("product_id")
  quantity      Int
  expiresAt     DateTime  @map("expires_at")
  actorUserId   String    @map("actor_user_id")
  correlationId String    @map("correlation_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  resolvedAt    DateTime? @map("resolved_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Composite FK, same pattern as ProductPricing/ProductStock.
  product  Product  @relation(fields: [productId, businessId], references: [id, businessId], onDelete: Cascade)

  @@index([businessId])
  @@index([productId])
  // Speeds the alert query's "unresolved batches expiring soon" filter --
  // the one query this table exists to serve.
  @@index([businessId, resolvedAt, expiresAt])
  @@map("product_expiration_batches")
}
